{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Meta JSON Schema for versioned-md documents",
  "description": "Schema for companion .meta.json files that track version history",
  "type": "object",
  "required": ["version_history"],
  "properties": {
    "version_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "updated_by", "last_updated"],
        "properties": {
          "version": {
            "type": "string",
            "description": "Version number (e.g. '1', '42')"
          },
          "updated_by": {
            "type": "string",
            "description": "Person handle who made the change"
          },
          "last_updated": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Date in YYYY-MM-DD format"
          },
          "reviewer": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Reviewer handles from people.json"
          },
          "commit_hash": {
            "type": "string",
            "description": "Git commit SHA"
          },
          "pr_number": {
            "type": ["integer", "null"],
            "description": "Pull request number, or null if no PR"
          },
          "action": {
            "type": "string",
            "enum": ["created", "updated", "promoted", "imported"],
            "description": "Type of change for this version"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "additionalProperties": false
}
