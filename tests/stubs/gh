#!/usr/bin/env python3
"""Stand-in for the GitHub CLI, supporting only what the workflows use:

    gh api <path> --jq '.<field> // empty'

The request goes to $GITHUB_API_URL (the fake GitHub server in tests).
"""

import json
import os
import sys
import urllib.error
import urllib.request

args = sys.argv[1:]
if len(args) != 4 or args[0] != "api" or args[2] != "--jq" or not args[3].endswith(" // empty"):
    sys.exit(f"gh stub: unsupported arguments {args}")

path, field = args[1], args[3].removesuffix(" // empty").lstrip(".")
try:
    with urllib.request.urlopen(f"{os.environ['GITHUB_API_URL']}/{path}") as response:
        data = json.load(response)
except urllib.error.HTTPError as error:
    sys.exit(f"gh: HTTP {error.code}")

value = data.get(field)
if value is not None:
    print(value)
